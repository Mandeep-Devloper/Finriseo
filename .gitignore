# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but DO track the placeholder template so a fresh clone / CI knows which
# vars to set. It contains only empty/placeholder values, never real secrets.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local notes / scratch (not for GitHub)
/finriseowork/

# The standalone backend service is its own git repository with its own remote
# (CLAUDE.md §6). It lives here only while the split is in progress. Git will not
# descend into a nested repo, so without this rule `git add -A` would stage
# `backend` as a submodule gitlink pointing at a commit this repo cannot resolve.
/backend/

# Bulk pincode dataset (re-downloaded by scripts/import-pincodes.mjs if missing)
/prisma/data/*.csv
