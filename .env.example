# ── Supabase / Postgres ─────────────────────────────────────────────
# From Supabase: Project Settings → Database → Connection string.
#
# DATABASE_URL = "Transaction" pooler (port 6543). Used by the app at runtime
#                on serverless. Must include ?pgbouncer=true&connection_limit=1
# DIRECT_URL   = "Session" / direct connection (port 5432). Used by Prisma
#                Migrate for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV="development"

# Trusted reverse-proxy hops in front of the app, used to pick the real client IP
# from X-Forwarded-For for rate limiting (defends against XFF spoofing). Vercel
# with no extra proxy = 1 (the default when unset). Increase only if you add
# proxies/CDN layers in front. See src/lib/http/ip.ts.
# TRUSTED_PROXY_HOPS="1"

# ── PII encryption at rest (optional; PAN) ──────────────────────────
# When set, the PAN column is AES-256-GCM encrypted at rest via
# src/lib/crypto/pii.ts. Unset = passthrough (PAN stored as plaintext — current
# default). Must decode to exactly 32 bytes (base64 OR hex). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TODO(compliance): choose a key-custody model (env secret vs managed KMS +
# rotation) before storing real applicants' PANs. Enabling is a safe, incremental
# rollout: new writes encrypt, existing plaintext still reads.
# PII_ENCRYPTION_KEY=""

# ── OTP via Firebase Phone Authentication ───────────────────────────
# OTP is sent + verified client-side by Firebase (reCAPTCHA + SMS); our server
# then verifies the returned Firebase ID token (firebase-admin).
#
# Client config — Firebase Console → Project settings → General → Your apps
# (Web app). These are public (NEXT_PUBLIC_*).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
#
# Admin/server credentials — Firebase Console → Project settings →
# Service accounts → Generate new private key (downloads a JSON file). Copy the
# values from it; keep the quotes and the literal \n newlines in the key.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
#
# Dev-only OTP bypass — Firebase blocks Phone Auth SMS on the free Spark plan
# (auth/billing-not-enabled). Setting BOTH flags to 1 (local dev only!) skips
# the SMS: any mobile + OTP 123456 signs in via a server-minted custom token,
# so the ID-token/session flow stays production-identical. Dead in production
# builds regardless (NODE_ENV gate). Remove after upgrading to Blaze.
# OTP_DEV_BYPASS=1
# NEXT_PUBLIC_OTP_DEV_BYPASS=1

# ── Analytics (optional) ────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=""

# ── Error monitoring (optional) ─────────────────────────────────────
# Sentry is wired (instrumentation + error boundaries) but a NO-OP until this
# DSN is set. Create a (free) Sentry project → Settings → Client Keys (DSN).
# Used by both the browser (NEXT_PUBLIC_) and the server.
# NEXT_PUBLIC_SENTRY_DSN=""

# ── Scheduled jobs (Vercel Cron) ────────────────────────────────────
# Secret shared with Vercel Cron. Set this in Vercel (Project → Settings → Env
# Vars); Vercel automatically sends it as `Authorization: Bearer <value>` to the
# /api/cron/* routes. The retention purge refuses to run without it. Generate a
# strong random value, e.g. `openssl rand -hex 32`.
# CRON_SECRET=""
