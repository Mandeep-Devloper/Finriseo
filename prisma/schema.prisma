generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Data retention (documented policy — enforce before/at launch) ──
// - Application: borrower PII (name, mobile, email, PAN). Retain while the
//   lead is active; define a purge window for stale drafts (e.g. drop `draft`
//   rows with no activity after 90 days) and for rejected/closed leads per the
//   privacy policy.
// - OtpLog / RateLimit: operational only. RateLimit self-prunes (>24h rows);
//   OtpLog should be pruned on a schedule (nothing needs it past ~90 days).
// - AuditLog: append-only and deliberately PII-free — retain long-term.
// - ContactMessage: contains contact PII; prune resolved messages periodically.
model Application {
  id              String   @id @default(cuid())
  referenceId     String   @unique
  mobile          String
  fullName        String
  email           String?
  pinCode         String?
  employmentType  String?
  // Money is stored as DECIMAL (never Float) so amounts and their sums are
  // exact — no binary-floating-point drift in disbursement/commission math.
  monthlyIncome   Decimal? @db.Decimal(14, 2)
  salaryMode      String?
  employer        String?
  experience      String?
  loanAmount      Decimal? @db.Decimal(14, 2)
  loanPurpose     String?
  // PAN is written/read ONLY through src/lib/crypto/pii.ts (encryptPii/decryptPii).
  // With PII_ENCRYPTION_KEY set it is AES-256-GCM encrypted at rest; unset, it
  // passes through as plaintext (current default). Either way its exposure surface
  // is deliberately minimal: excluded from sessionStorage, CSV exports, and all
  // logs; masked in the UI; full value visible only on the audited admin detail
  // view. TODO(compliance): choose a key-custody model and set the key — see pii.ts.
  panNumber       String?
  selectedOfferId Int?
  // Funnel position — lets you see exactly where a lead is/dropped off:
  // otp_verified -> basic_details -> employment -> pan_verified -> submitted
  currentStep     String   @default("otp_verified")
  // Business pipeline status. Starts as "draft" (funnel in progress, pre-submission);
  // becomes "submitted" once the user completes the final step, then moves through
  // contacted -> docs_pending -> sent_to_lender -> approved -> disbursed / rejected.
  status          String   @default("draft")
  source          String   @default("web")
  // Admin/DSA pipeline fields (set from the admin panel, never the borrower flow):
  assignedToId    String?  // owning agent (→ AdminUser); null = unassigned
  // The lender the DSA actually routed to / that disbursed. Distinct from
  // selectedOfferId (the offer the BORROWER picked in the funnel) — the admin
  // may route to a different lender. Feeds Phase 4 commission (× commissionRate).
  chosenLenderId  Int?
  disbursedAmount Decimal? @db.Decimal(14, 2)
  disbursedAt     DateTime?
  // ── Consent (audit-grade proof the borrower agreed to terms) ──
  // Captured server-side at draft creation from the OTP-verified session, so a
  // regulated lender partner can be shown WHO consented, to WHICH policy version,
  // WHEN, and from where. Nullable only for rows created before this column.
  consentAt        DateTime?
  consentVersion   String?   // e.g. "2026-07-04" — the terms/privacy version shown
  consentIp        String?   // trusted client IP at the moment of consent
  consentUserAgent String?   // raw UA string, for dispute forensics
  // OPTIONAL WhatsApp-updates opt-in, distinct from the mandatory T&C consent.
  // It was previously a locked pre-ticked checkbox (a DPDP dark pattern) whose
  // value was never even stored; now it is a real user choice recorded here.
  // Nullable: rows created before this column (or where no signal was sent)
  // are "unknown", not "no".
  whatsappOptIn    Boolean?
  // ── Magic Resume (draft resume state; single-row read) ──
  currentRoute   String?            // exact route to restore, e.g. "/apply/employment"
  progressPct    Int      @default(0)
  completedSteps String[] @default([])
  // JSONB snapshot of NON-SENSITIVE funnel fields for full restore. PAN is
  // NEVER written here (enforced in three layers: PATCH route, draft API, autosave).
  draftData      Json?
  lastActivityAt DateTime @default(now())
  // Stale-draft purge horizon for the retention job; nullable for old rows.
  expiresAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignedTo      AdminUser? @relation("AssignedApplications", fields: [assignedToId], references: [id])
  chosenLender    Lender?    @relation(fields: [chosenLenderId], references: [id])
  notes           Note[]
  trustedSessions TrustedSession[]

  @@index([mobile])
  @@index([status])
  @@index([createdAt])
  @@index([assignedToId])
  @@index([lastActivityAt])
}

// Trusted-browser session for Magic Resume. DB-backed so it is revocable and
// server-visible. The raw 32-byte token lives ONLY in the httpOnly finriseo_trust
// cookie; here we store only its SHA-256 hash (a DB leak can't be replayed).
// Authorizes DRAFT-scoped operations for one browser for 7 days (sliding, capped
// at 30 days). NEVER authorizes submitted records or admin routes.
model TrustedSession {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  applicationId  String
  mobile         String
  fingerprint    String    // soft device bind: hash(UA + Accept-Language)
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  expiresAt      DateTime  // sliding: now + 7d, capped at absoluteExpiry
  absoluteExpiry DateTime  // hard cap: createdAt + 30d
  revokedAt      DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([mobile])
  @@index([expiresAt])
  @@index([applicationId])
}

// Internal admin notes on an application. Author is an AdminUser; the body may
// contain free text, so Notes are admin-only and never exposed to borrowers.
model Note {
  id            String   @id @default(cuid())
  applicationId String
  authorId      String
  body          String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      AdminUser  @relation("AuthoredNotes", fields: [authorId], references: [id])

  @@index([applicationId])
}

// Admin panel users. Separate from borrowers entirely: admins authenticate with
// Firebase Email/Password (never phone OTP). Role + active here are the SERVER
// source of truth for authorization — the Firebase account only proves identity.
// firebaseUid links to the Firebase Auth user; email is the business identity.
model AdminUser {
  id          String    @id @default(cuid())
  email       String    @unique
  firebaseUid String    @unique
  name        String
  role        Role      @default(AGENT)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  // Back-relations (populated as later phases add the columns).
  auditEntries         AuditLog[]    @relation("AdminAuditActor")
  assignedApplications Application[] @relation("AssignedApplications")
  authoredNotes        Note[]        @relation("AuthoredNotes")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
}

model OtpLog {
  id        String   @id @default(cuid())
  mobile    String
  status    String   // sent | verified | expired | failed
  createdAt DateTime @default(now())

  @@index([mobile])
  @@index([createdAt])
}

// Append-only audit trail of application lifecycle events. Records the actor
// (Firebase uid from the verified session) rather than any PII, so the log
// itself stays PII-free. Written via a single service: src/lib/services/auditLog.ts
model AuditLog {
  id          String   @id @default(cuid())
  referenceId String   // borrower application referenceId, OR the target id for
                       // non-application admin actions (disambiguated by targetType)
  actorUid    String?  // Firebase uid of the authenticated session, if known
  action      String   // borrower: started|updated|submitted · admin: e.g.
                       // view_detail|status_change|assign|note|export|lender_*|user_*
  lender      String?  // resulting lender routing (selected offer), on submit
  // Admin-action fields (nullable — borrower-flow rows leave these unset):
  actorAdminId String? // FK → AdminUser, set when an admin performed the action
  targetType   String? // "application" | "lender" | "admin_user" | "contact"
  createdAt   DateTime @default(now())

  actorAdmin  AdminUser? @relation("AdminAuditActor", fields: [actorAdminId], references: [id])

  @@index([referenceId])
  @@index([createdAt])
  @@index([actorAdminId])
}

// Singleton app settings (always id = 1). Business info shown across the panel,
// plus a default commission rate used as a FALLBACK in dashboard commission
// estimates when a lender has no commissionRate of its own.
model AppSetting {
  id                    Int      @id @default(1)
  businessName          String?
  supportEmail          String?
  supportPhone          String?
  address               String?
  defaultCommissionRate Decimal? @db.Decimal(6, 3)
  updatedAt             DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  subject   String
  message   String
  status    String   @default("unread")
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// Serverless-safe rate limiting (replaces in-memory Maps).
// One row per rate-limit key, e.g. "otp:9999999999" or "ip:1.2.3.4:submit".
model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

// DB-driven loan offers (replaces hardcoded Partner A/B/C).
model Lender {
  id            Int      @id @default(autoincrement())
  name          String
  interestRate  Decimal  @db.Decimal(6, 3) // annual % p.a.
  tenureMonths  Int
  processingFee String   // display string, e.g. "1.5%"
  color         String   // accent color for the offer card
  minIncome     Decimal  @default(0) @db.Decimal(14, 2)  // minimum monthly income to qualify
  maxMultiplier Decimal  @default(10) @db.Decimal(6, 3)  // max loan = monthlyIncome * maxMultiplier
  active        Boolean  @default(true)
  priority      Int      @default(0)     // higher shows first
  // ── Admin-managed eligibility / commercials (Phase 3) ──
  // All additive + nullable/defaulted so existing rows and the offers engine
  // behave exactly as before until an admin sets a value.
  logoUrl         String?                     // lender logo (display)
  interestRateMax Decimal? @db.Decimal(6, 3)  // upper bound of a display rate range; interestRate is the "from" rate (drives EMI)
  minAmount       Decimal? @db.Decimal(14, 2) // absolute minimum loan this lender funds
  maxAmount       Decimal? @db.Decimal(14, 2) // absolute maximum loan (capped on top of income × maxMultiplier)
  minAge          Int?                        // stored for management; NOT enforced (funnel collects no age)
  maxAge          Int?                        // stored for management; NOT enforced
  maxFoir         Decimal? @db.Decimal(6, 3)  // stored for management; NOT enforced (no obligations collected)
  employmentTypes String[] @default([]) // [] = any employment; else borrower's employmentType must be in this list
  loanTypes       String[] @default([]) // loan products this lender serves (display / optional filtering)
  commissionRate  Decimal? @db.Decimal(6, 3)  // % of disbursed amount → Phase 4 commission estimates
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications Application[] // applications this lender disbursed/handled

  @@index([active])
}

// Self-hosted India Post PIN-code directory (~155k rows, one per post office).
// Populated once from the official "All India Pincode Directory" via
// `scripts/import-pincodes.mjs`; queried by the /api/pincode route so PIN→location
// lookups need no runtime call to India Post for the ~19k known PINs. A PIN absent
// here falls back to the live India Post API (see src/lib/services/pincodeLookup.ts).
//
// A PIN maps to MANY offices that all share the same district/state, so lookups
// read any matching row. The (pincode, officeName) unique key makes the bulk
// import idempotent (re-runnable) via createMany({ skipDuplicates: true }).
model Pincode {
  id             Int      @id @default(autoincrement())
  pincode        String   @db.VarChar(6)
  officeName     String
  district       String
  state          String
  circle         String?
  region         String?
  division       String?
  taluk          String?
  officeType     String? // B.O (Branch), S.O (Sub), H.O (Head)
  deliveryStatus String? // Delivery | Non-Delivery
  createdAt      DateTime @default(now())

  @@unique([pincode, officeName])
  @@index([pincode])
  @@map("pincodes")
}
